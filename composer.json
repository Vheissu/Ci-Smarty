{
    "name": "vheissu/ci-smarty",
    "description": "Smarty 5 template engine integration for CodeIgniter 4",
    "type": "library",
    "keywords": [
        "codeigniter",
        "codeigniter4",
        "smarty",
        "templates",
        "view"
    ],
    "homepage": "https://github.com/Vheissu/Ci-Smarty",
    "license": "MIT",
    "authors": [
        {
            "name": "Dwayne Charrington",
            "email": "dwaynecharrington@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "smarty/smarty": "^5.8.4"
    },
    "require-dev": {
        "codeigniter/phpstan-codeigniter": "^1.5",
        "codeigniter4/framework": "^4.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.2"
    },
    "conflict": {
        "codeigniter4/framework": "<4.5"
    },
    "autoload": {
        "psr-4": {
            "Vheissu\\CiSmarty\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "analyze": "phpstan analyse",
        "test": "phpunit"
    }
}
